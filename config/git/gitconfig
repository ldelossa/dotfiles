[core]
	excludesfile = ~/.gitignore

[user]
	email = louis.delos@gmail.com
	name = ldelossa
[init]
	defaultBranch = main

[interactive]

[merge]
    conflictstyle = diff3

[difftool]
    prompt = true

[diff]
    tool = nvimdiff

[difftool "nvimdiff"]
	cmd = "/home/louis/.config/git/difftool_wrapper.sh $LOCAL $REMOTE"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[commit]
    verbose = true

[rerere]
	enabled = true

[alias]
	fix = commit --fixup

[sendemail]
	smtpServer = /usr/bin/msmtp
	b4-really-reflect-via = /usr/bin/msmtp

[hook "push-allow-list"]
	event = pre-push
	command = ~/zsh.d/cmds/git/.push-allow-list-hook.sh
[url "git@github.com:isovalent/"]
	insteadOf = https://github.com/isovalent/
