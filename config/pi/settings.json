{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.5.2",
  "theme": "system",
  "quietStartup": "header",
  "treeFilterMode": "no-tools",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-subagents",
    "npm:pi-ask-user",
    "npm:pi-vim",
    "npm:pi-web-access",
    "npm:@aliou/pi-guardrails",
    "npm:pi-theme-picker",
    "npm:@spences10/pi-themes",
    "npm:@ldelossa/pi-ide",
    "git:github.com/ldelossa/pi-plan-mode",
    "npm:@injaneity/pi-computer-use"
  ],
  "hideThinkingBlock": true,
  "piPlanMode": {
    "plan": {
      "model": {
        "provider": "openai-codex",
        "id": "gpt-6.1-sol"
      },
      "thinking": "xhigh"
    },
    "execute": {
      "model": {
        "provider": "deepseek",
        "id": "deepseek-v4-pro"
      },
      "thinking": "xhigh"
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@trevonistrevon/pi-loop\",\"scope\":\"user\"}": "0.8.0",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.88.1",
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.48.0",
    "{\"source\":\"npm:@aliou/pi-guardrails\",\"scope\":\"user\"}": "0.23.0",
    "{\"source\":\"npm:pi-theme-picker\",\"scope\":\"user\"}": "0.1.2",
    "{\"source\":\"git:github.com/ldelossa/pi-plan-mode\",\"scope\":\"user\"}": "0.26.2"
  }
}