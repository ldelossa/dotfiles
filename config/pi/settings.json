{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "lastChangelogVersion": "1.3.0",
  "theme": "system",
  "quietStartup": "header",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultTools": ["+codemode"],
  "packages": [
    "npm:@trevonistrevon/pi-loop",
    "npm:pi-subagents",
    "npm:pi-ask-user",
    "npm:pi-vim",
    "npm:pi-web-access",
    "npm:@aliou/pi-guardrails",
    "npm:pi-theme-picker",
    "npm:@spences10/pi-themes",
    "npm:@ldelossa/pi-ide",
    "git:github.com/ldelossa/pi-plan-mode",
    "npm:@injaneity/pi-computer-use",
    "git:github.com/ldelossa/pi-edit-last"
  ],
  "hideThinkingBlock": true,
  "piPlanMode": {
    "plan": {
      "model": {
        "provider": "openai-codex",
        "id": "gpt-6.1-sol"
      },
      "thinking": "xhigh"
    },
    "execute": {
      "model": {
        "provider": "deepseek",
        "id": "deepseek-v4-pro"
      },
      "thinking": "xhigh"
    }
  }
}